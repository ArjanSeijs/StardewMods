<Project Sdk="Microsoft.NET.Sdk">

    
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>10</LangVersion>
        <EnableHarmony>true</EnableHarmony>

        <!-- Manifest fields -->
        <Name>ShedMonitor</Name>
        <Authors>EternalSoap</Authors>
        <Description>View the Inventory of your Shed as a big Chest</Description>
        <UniqueID>EternalSoap.ShedMonitor</UniqueID>
        <MinimumGameVersion>1.6</MinimumGameVersion>
        <MinimumApiVersion>4.5.2</MinimumApiVersion>
        <RootNamespace>ShedMonitor</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Leclair.Stardew.ModManifestBuilder" Version="2.4.1"/>
        <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0"/>
        <PackageReference Include="PropertyChanged.SourceGenerator" Version="1.1.2">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="StardewUI">
            <HintPath>$(GameModsPath)\StardewUI\StardewUI.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>


</Project>