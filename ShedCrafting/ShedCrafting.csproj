<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>10</LangVersion>
        <EnableHarmony>true</EnableHarmony>

        <!-- Manifest fields -->
        <Name>ShedCrafting</Name>
        <Authors>EternalSoap</Authors>
        <Description>Adds Chest Inside Building To Crafting Station</Description>
        <UniqueID>EternalSoap.ShedCrafting</UniqueID>
        <MinimumGameVersion>1.6</MinimumGameVersion>
        <MinimumApiVersion>4.5.2</MinimumApiVersion>
        <UpdateKeys>Nexus:12345</UpdateKeys>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Leclair.Stardew.ModManifestBuilder" Version="2.4.1"/>
        <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0"/>
    </ItemGroup>

</Project>